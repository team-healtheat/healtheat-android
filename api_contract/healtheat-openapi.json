  "components": {
    "schemas": {
      "ProfileRequest": {
        "type": "object",
        "properties": {
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "gender": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "gender": {
            "type": "string"
          }
        }
      },
      "ConfirmRequest": {
        "type": "object",
        "properties": {
          "factors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfirmedFactor"
            },
            "maxItems": 50,
            "minItems": 0
          }
        },
